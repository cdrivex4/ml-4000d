# Strict Canon Proprietary & Copyrighted Material Blacklist
firmware/
*.FIR
*.fir
*.BIN
*.bin
!liveSDCard/autoexec.bin
romdump/
update-procedure-pdf/
*.dumper

# Toolchains, Emulators & Heavy Environments
tools/*
!tools/card_prep/
ghidra/
qemu-eos/
rea/
.venv/
node_modules/
magic-lantern/
magic-lantern-1300d/
scratch/
graphify-out/cache/



# Local Backups & Runtime Logs
sd_card_backup/
*.log
*.LOG
liveSDCard/ML/LOGS/archive/
liveSDCard/ML/LOGS/*.LOG
liveSDCard/ML/LOGS/*.log
liveSDCard/ML/SETTINGS/*.CFG
liveSDCard/ML/SETTINGS/*.cfg

# Compiler & Intermediate Build Artifacts
*.o
*.d
*.map
*.elf
*.exe
!tools/card_prep/*.exe
*.dll
!tools/card_prep/*.dll
*.zip
*.tar.gz
*.pyc
__pycache__/

# OS & Editor Metadata
.DS_Store
Thumbs.db
desktop.ini
.vscode/
.idea/
System Volume Information/
*.html
debug.JPG
