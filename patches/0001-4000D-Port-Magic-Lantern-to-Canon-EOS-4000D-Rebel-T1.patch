+static void boot_log(const char* fmt, ...)
+{
+    va_list ap;
+    va_start(ap, fmt);
+    char tmp[256];
+    int n = vsnprintf(tmp, sizeof(tmp), fmt, ap);
+    va_end(ap);
+    if (n > 0) {
+        if (boot_log_len + n < (int)sizeof(boot_log_buf) - 1) {
+            memcpy(boot_log_buf + boot_log_len, tmp, n);
+            boot_log_len += n;
+            boot_log_buf[boot_log_len] = '\0';
+        }
+        FILE* f = FIO_CreateFile("B:/BOOT.LOG");
+        if (!f) f = FIO_CreateFile("A:/BOOT.LOG");
+        if (!f) f = FIO_CreateFile("BOOT.LOG");
+        if (f) {
+            dbg_fwrite(f, boot_log_buf, boot_log_len);
+            FIO_CloseFile(f);
+        }
+    }
